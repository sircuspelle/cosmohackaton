#!/usr/bin/env bash

echo "========================================"
echo "Running tests before push..."
echo "========================================"

# Запускаем тесты с помощью pytest
python -m pytest src/test/ -v

# Проверяем код возврата pytest
if [ $? -ne 0 ]; then
  echo "========================================"
  echo "ERROR: Tests failed! Push aborted."
  echo "========================================"
  exit 1
fi

echo "========================================"
echo "Tests passed! Proceeding with push."
echo "========================================"
exit 0

